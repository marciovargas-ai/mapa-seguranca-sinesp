let indiceMunicipiosCache_ = null;

/**
 * Monta (uma vez por execução) os índices por UF+nome normalizado e por código IBGE.
 */
function obterIndiceMunicipios_() {
  if (indiceMunicipiosCache_) return indiceMunicipiosCache_;
  const porNome = {};
  const porCodigo = {};
  Object.keys(BASE_MUNICIPIOS_BR).forEach(uf => {
    BASE_MUNICIPIOS_BR[uf].split(';').forEach(reg => {
      const p = reg.split('|');
      const mun = { uf: uf, nome: p[0], ibge: CODIGO_IBGE_UF[uf] + p[1], lat: Number(p[2]), lng: Number(p[3]) };
      porNome[uf + '|' + normalizarTexto_(mun.nome)] = mun;
      porCodigo[mun.ibge] = mun;
    });
  });
  indiceMunicipiosCache_ = { porNome: porNome, porCodigo: porCodigo };
  return indiceMunicipiosCache_;
}

/**
 * Retorna { uf, nome, ibge, lat, lng } do município, ou null se não existir.
 */
function obterMunicipioBase_(uf, nomeCidade) {
  if (!uf || !nomeCidade) return null;
  return obterIndiceMunicipios_().porNome[String(uf).toUpperCase() + '|' + normalizarTexto_(nomeCidade)] || null;
}

function obterMunicipioPorCodigoIbge_(codigo) {
  return obterIndiceMunicipios_().porCodigo[String(codigo || '')] || null;
}

function listarMunicipiosUF_(uf) {
  const sigla = String(uf || '').toUpperCase();
  if (!BASE_MUNICIPIOS_BR[sigla]) return [];
  return BASE_MUNICIPIOS_BR[sigla].split(';').map(reg => {
    const p = reg.split('|');
    return { uf: sigla, nome: p[0], ibge: CODIGO_IBGE_UF[sigla] + p[1], lat: Number(p[2]), lng: Number(p[3]) };
  });
}

/**
 * Usado pelo template do painel: <?!= obterBaseMunicipiosJson() ?>
 */
function obterBaseMunicipiosJson() {
  return JSON.stringify({ codigosUf: CODIGO_IBGE_UF, municipios: BASE_MUNICIPIOS_BR });
}
